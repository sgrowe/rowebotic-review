#!/bin/sh
# Run by rowebotic-review after `jj git fetch`, from the repo root.
# Rebase onto trunk so `make migrate` runs trunk's migrations, then install and migrate.
# PGDATABASE comes from the environment (direnv: .envrc sets humaans_hpi).
set -e
jj rebase -d 'trunk()' --simplify-parents
pnpm install --frozen-lockfile
make migrate
