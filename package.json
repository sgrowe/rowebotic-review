{
  "name": "rowebotic-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel AI code review of GitHub PRs with jj, Codex and Monty codemode",
  "bin": {
    "rowebotic-review": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test 'test/**/*.test.ts'",
    "install-locally": "npm install && npm link"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pydantic/monty": "^1.6.0",
    "openai": "^7.62.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}
